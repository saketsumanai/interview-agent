# LiveKit Cloud Configuration
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# LLM & Inference Services (Groq for sub-50ms live voice, Gemini for evaluation fallback)
GROQ_API_KEY=your_groq_api_key
GOOGLE_API_KEY=your_google_gemini_api_key

# Speech-to-Text Providers
# Deepgram Streaming WebSocket (Preferred for ultra-low latency & conversational Flux / Nova-3)
# Sign up at: https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key
STT_PROVIDER=deepgram               # Options: 'deepgram', 'groq', 'assemblyai'
DEEPGRAM_MODEL=flux-general-en      # Options: 'flux-general-en' (WebSocket v2), 'nova-3' (WebSocket v1)
DEEPGRAM_ENDPOINTING_MS=300         # Nova-3 endpointing silence duration (ms)
DEEPGRAM_EOT_THRESHOLD=0.75         # Flux End-Of-Turn confidence threshold (0.0 - 1.0)
DEEPGRAM_EOT_TIMEOUT_MS=2500        # Flux max silence timeout before EOT

# Alternative STT & Voice Pipeline
ASSEMBLYAI_API_KEY=your_assemblyai_api_key
CARTESIA_API_KEY=your_cartesia_api_key

# Optional Google Cloud Storage (for video interview archival)
GCS_BUCKET_NAME=your_gcs_bucket_name
GOOGLE_APPLICATION_CREDENTIALS=